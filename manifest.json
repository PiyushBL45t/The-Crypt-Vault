{
  "manifest_version": 3,
  "name": "Vault — Credential Keeper",
  "version": "1.0.0",
  "description": "A locally encrypted credential vault for quick copy-paste access. Nothing ever leaves your machine.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"]
}
